   "source": [
    "# Ultimate Pokémon Data Scraper\n",
    "\n",
    "This notebook allows you to easily pull Pokémon data from **four different environments** with zero setup. It outputs both a JSON database and a flattened CSV spreadsheet.\n",
    "\n",
    "### Supported Data Sources:\n",
    "1. **`pokeapi`**: Standard Gen 1-9 Pokémon Base Stats, Types, Abilities, and Lore from PokeAPI.\n",
    "2. **`tcg`**: Real Pokémon Trading Card Game cards (HP, attacks, sets) from the Pokémon TCG API.\n",
    "3. **`smogon`**: Competitive usage data and tiers from Pokemon Showdown (Smogon).\n",
    "4. **`pokeapi_game`**: Fetch Pokémon stats/sprites specifically for a given Game Version (e.g. Red, Crystal, Emerald).\n",
    "\n",
    "---\n",
    "\n",
    "### Step 1: Configure & Run\n",
    "Change the `DATA_SOURCE` variable in the code block below to choose which data you want to scrape. Then click the **Play** button to run the code."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests\n",
    "import json\n",
    "import time\n",
    "import csv\n",
    "import os\n",
    "\n",
    "# ==========================================\n",
    "# ⚙️ CONFIGURATION ZONE\n",
    "# ==========================================\n",
    "\n",
    "# Which data source to use?\n",
    "# Options: \"pokeapi\", \"tcg\", \"smogon\", \"pokeapi_game\"\n",
    "DATA_SOURCE = \"pokeapi\"\n",
    "\n",
    "# How many Pokémon/Cards to fetch? (For full pokeapi run, set to 1025. For TCG, set to 500+)\n",
    "FETCH_LIMIT = 1025\n",
    "\n",
    "# If using DATA_SOURCE = \"pokeapi_game\", which game version?\n",
    "# e.g., \"red\", \"crystal\", \"emerald\", \"scarlet\"\n",
    "GAME_VERSION = \"red\"\n",
    "\n",
    "# ==========================================\n",
    "# 🚀 SCRAPING LOGIC\n",
    "# ==========================================\n",
    "\n",
    "POKE_API_BASE_URL = \"https://pokeapi.co/api/v2\"\n",
    "TCG_API_BASE_URL = \"https://api.pokemontcg.io/v2\"\n",
    "SMOGON_DATA_URL = \"https://play.pokemonshowdown.com/data/pokedex.json\"\n",
    "\n",
    "def get_type_chart():\n",
    "    print(\"--- Pre-loading Type Chart ---\")\n",
    "    type_chart = {}\n",
    "    for i in range(1, 19): \n",
    "        url = f\"{POKE_API_BASE_URL}/type/{i}\"\n",
    "        data = requests.get(url).json()\n",
    "        type_name = data['name']\n",
    "        type_chart[type_name] = data['damage_relations']\n",
    "    return type_chart\n",
    "\n",
    "def calculate_weaknesses(pokemon_types, type_chart):\n",
    "    weaknesses = {\n",
    "        \"normal\": 1.0, \"fire\": 1.0, \"water\": 1.0, \"electric\": 1.0, \"grass\": 1.0, \n",
    "        \"ice\": 1.0, \"fighting\": 1.0, \"poison\": 1.0, \"ground\": 1.0, \"flying\": 1.0, \n",
    "        \"psychic\": 1.0, \"bug\": 1.0, \"rock\": 1.0, \"ghost\": 1.0, \"dragon\": 1.0, \n",
    "        \"steel\": 1.0, \"dark\": 1.0, \"fairy\": 1.0\n",
    "    }\n",
    "    for p_type in pokemon_types:\n",
    "        relations = type_chart.get(p_type)\n",
    "        if not relations: continue\n",
    "        for t in relations['double_damage_from']: weaknesses[t['name']] *= 2.0\n",
    "        for t in relations['half_damage_from']: weaknesses[t['name']] *= 0.5\n",
    "        for t in relations['no_damage_from']: weaknesses[t['name']] *= 0.0\n",
    "    return weaknesses\n",
    "\n",
    "def fetch_pokeapi(limit):\n",
    "    all_pokemon = []\n",
    "    type_chart = get_type_chart()\n",
    "    print(f\"Starting download of {limit} Pokemon from standard PokeAPI...\")\n",
    "    for i in range(1, limit + 1):\n",
    "        try:\n",
    "            url = f\"{POKE_API_BASE_URL}/pokemon/{i}\"\n",
    "            response = requests.get(url)\n",
    "            if response.status_code != 200: continue\n",
    "            data = response.json()\n",
    "            \n",
    "            species_response = requests.get(data['species']['url'])\n",
    "            current_types = [t['type']['name'] for t in data['types']]\n",
    "            \n",
    "            description = \"No description available.\"\n",
    "            is_legendary = False\n",
    "            \n",
    "            if species_response.status_code == 200:\n",
    "                species_data = species_response.json()\n",
    "                for entry in species_data.get('flavor_text_entries', []):\n",
    "                    if entry['language']['name'] == 'en':\n",
    "                        description = entry['flavor_text'].replace('\\n', ' ').replace('\\f', ' ')\n",
    "                        break\n",
    "                is_legendary = species_data.get('is_legendary', False)\n",
    "\n",
    "            damage_taken = calculate_weaknesses(current_types, type_chart)\n",
    "            entry = {\n",
    "                \"id\": data['id'],\n",
    "                \"name\": data['name'],\n",
    "                \"types\": current_types,\n",
    "                \"is_legendary\": is_legendary,\n",
    "                \"description\": description,\n",
    "                \"damage_taken\": damage_taken\n",
    "            }\n",
    "            all_pokemon.append(entry)\n",
    "            print(f\"Got #{i}: {data['name']}\")\n",
    "        except Exception as e:\n",
    "            print(f\"Error fetching #{i}: {e}\")\n",
    "    \n",
    "    filename = 'complete_pokedex.json'\n",
    "    with open(filename, 'w') as f: json.dump(all_pokemon, f, indent=4)\n",
    "    return filename\n",
    "\n",
    "def fetch_tcg(limit):\n",
    "    print(f\"Starting download of {limit} Pokemon cards from TCG API...\")\n",
    "    all_cards = []\n",
    "    page, fetched = 1, 0\n",
    "    while fetched < limit:\n",
    "        try:\n",
    "            response = requests.get(f\"{TCG_API_BASE_URL}/cards?page={page}&pageSize=50\")\n",
    "            if response.status_code != 200: break\n",
    "            data = response.json().get('data', [])\n",
    "            if not data: break\n",
    "            for card in data:\n",
    "                if fetched >= limit: break\n",
    "                entry = {\n",
    "                    \"id\": card.get('id'), \"name\": card.get('name'),\n",
    "                    \"hp\": card.get('hp'), \"types\": card.get('types', []),\n",
    "                    \"set_name\": card.get('set', {}).get('name')\n",
    "                }\n",
    "                all_cards.append(entry)\n",
    "                print(f\"Got TCG Card: {entry['name']} ({entry['id']})\")\n",
    "                fetched += 1\n",
    "            page += 1\n",
    "        except Exception as e:\n",
    "            print(f\"Error: {e}\"); break\n",
    "    filename = 'tcg_pokedex.json'\n",
    "    with open(filename, 'w') as f: json.dump(all_cards, f, indent=4)\n",
    "    return filename\n",
    "\n",
    "def fetch_smogon():\n",
    "    print(\"Starting download of Smogon competitive Pokemon data...\")\n",
    "    response = requests.get(SMOGON_DATA_URL)\n",
    "    all_pokemon = []\n",
    "    if response.status_code == 200:\n",
    "        data = response.json()\n",
    "        for key, mon in data.items():\n",
    "            all_pokemon.append({\"id\": mon.get('num'), \"name\": mon.get('name'), \"tier\": mon.get('tier')})\n",
    "            print(f\"Got Smogon Pokemon: {mon.get('name')}\")\n",
    "    filename = 'smogon_pokedex.json'\n",
    "    with open(filename, 'w') as f: json.dump(all_pokemon, f, indent=4)\n",
    "    return filename\n",
    "\n",
    "def fetch_pokeapi_game_specific(limit, game_version):\n",
    "    print(f\"Starting download of {limit} Pokemon from PokeAPI for game version: {game_version}...\")\n",
    "    all_pokemon = []\n",
    "    for i in range(1, limit + 1):\n",
    "        response = requests.get(f\"{POKE_API_BASE_URL}/pokemon/{i}\")\n",
    "        if response.status_code == 200:\n",
    "            data = response.json()\n",
    "            all_pokemon.append({\"id\": data['id'], \"name\": data['name'], \"game_version\": game_version})\n",
    "            print(f\"Got #{i} for {game_version}: {data['name']}\")\n",
    "    filename = f'pokeapi_{game_version}_pokedex.json'\n",
    "    with open(filename, 'w') as f: json.dump(all_pokemon, f, indent=4)\n",
    "    return filename\n",
    "\n",
    "# RUN THE SCRAPER\n",
    "json_file = \"\"\n",
    "if DATA_SOURCE == \"pokeapi\": json_file = fetch_pokeapi(FETCH_LIMIT)\n",
    "elif DATA_SOURCE == \"tcg\": json_file = fetch_tcg(FETCH_LIMIT)\n",
    "elif DATA_SOURCE == \"smogon\": json_file = fetch_smogon()\n",
    "elif DATA_SOURCE == \"pokeapi_game\": json_file = fetch_pokeapi_game_specific(FETCH_LIMIT, GAME_VERSION)\n",
    "print(f\"\\n✅ Scraper Finished! Data saved to {json_file}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 2: Convert JSON to CSV\n",
    "Run the cell below to flatten the complex JSON file generated above into an easy-to-read CSV (Spreadsheet) format."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def flatten_dict(d, parent_key='', sep='_'):\n",
    "    items = []\n",
    "    for k, v in d.items():\n",
    "        new_key = f\"{parent_key}{sep}{k}\" if parent_key else k\n",
    "        if isinstance(v, dict):\n",
    "            items.extend(flatten_dict(v, new_key, sep=sep).items())\n",
    "        elif isinstance(v, list):\n",
    "            if all(isinstance(i, (str, int, float)) for i in v):\n",
    "                items.append((new_key, \", \".join(map(str, v))))\n",
    "            else:\n",
    "                items.append((new_key, json.dumps(v)))\n",
    "        else:\n",
    "            items.append((new_key, v))\n",
    "    return dict(items)\n",
    "\n",
    "if json_file:\n",
    "    csv_file = json_file.replace('.json', '.csv')\n",
    "    with open(json_file, 'r') as f: data = json.load(f)\n",
    "    \n",
    "    flattened_data = [flatten_dict(item) for item in data]\n",
    "    headers = set()\n",
    "    for item in flattened_data: headers.update(item.keys())\n",
    "    headers = sorted(list(headers))\n",
    "    if 'name' in headers: headers.remove('name'); headers.insert(0, 'name')\n",
    "    if 'id' in headers: headers.remove('id'); headers.insert(0, 'id')\n",
    "        \n",
    "    with open(csv_file, 'w', newline='', encoding='utf-8') as f:\n",
    "        writer = csv.DictWriter(f, fieldnames=headers)\n",
    "        writer.writeheader()\n",
    "        for item in flattened_data: writer.writerow(item)\n",
    "            \n",
    "    print(f\"✅ Successfully Converted! Saved as {csv_file}\")\n"
   ]
  },
  {
